{
  "manifest_version": 3,
  "name": "【聆竹】音频嗅探下载器",
  "version": "1.3.0",
  "description": "检测网页中正在播放的音频，页面角落弹出简洁卡片，一键下载音频文件（可选保存路径、可选下载前改文件名）。支持 new Audio() 游离元素与 iframe 内播放。",
  "minimum_chrome_version": "116",
  "key": "",

  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "activeTab"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "src/background.js"
  },

  "action": {
    "default_popup": "src/popup.html",
    "default_title": "【聆竹】音频嗅探下载器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/page-hook.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}
